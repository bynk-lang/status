commons status.page

uses status.model
uses bynk.string

-- The status page: one card per target, with its current state, response
-- time, uptime over a day and a week, and a strip of its recent checks.
---
Escapes text for an HTML body or a double-quoted attribute.
---
fn escape(s: String) -> String {
	s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

---
How long ago something happened, in words, from two epoch-millisecond times.
---
fn ago(thenMs: Int, nowMs: Int) -> String {
	let minutes = (nowMs - thenMs) / 60000
	match minutes < 1 {
		true => "just now",
		false => match minutes < 60 {
			true => "\(minutes) min ago",
			false => match minutes < 2880 {
				true => "\(minutes / 60) h ago",
				false => "\(minutes / 1440) days ago",
			},
		},
	}
}

---
An uptime percentage scaled by ten (`999`) as text (`99.9%`), or a dash.
---
fn percent(scaled: Int) -> String {
	match scaled < 0 {
		true => "–",
		false => "\(scaled / 10).\(scaled - scaled / 10 * 10)%",
	}
}

---
The strip of recent checks, oldest on the left.
---
fn strip(recent: List[Bool]) -> String {
	let bars = join(
		recent.map((up) => match up {
			true => "<i class=\"u\"></i>",
			false => "<i class=\"d\"></i>",
		}),
		""
	)
	"<div class=\"strip\" aria-label=\"recent checks, oldest first\">\(bars)</div>"
}

---
One target's card.
---
fn card(s: Summary, nowMs: Int) -> String {
	let state = match s.checked {
		false => "<span class=\"state none\">not checked yet</span>",
		true => match s.up {
			true => "<span class=\"state up\">up</span>",
			false => "<span class=\"state down\">down</span>",
		},
	}
	let detail = match s.checked {
		false => "",
		true => match s.status {
			0 => "no response · checked \(ago(s.last_at, nowMs))",
			_ => "\(s.status) in \(s.ms) ms · checked \(ago(s.last_at, nowMs))",
		},
	}
	let failure = match s.last_failure_at {
		0 => "never failed in the last 7 days",
		_ => "last failed \(ago(s.last_failure_at, nowMs))",
	}
	"<li class=\"card\"><h2>\(escape(s.name)) \(state)</h2><p class=\"url\"><a href=\"\(escape(s.url))\">\(escape(s.url))</a></p><p>\(detail)</p><p>Uptime: \(percent(s.uptime_24h)) (24 h) · \(percent(s.uptime_7d)) (7 days) · \(failure)</p>\(strip(s.recent))</li>"
}

---
The whole page.
---
fn render(summaries: List[Summary], nowMs: Int) -> String {
	let cards = join(summaries.map((s) => card(s, nowMs)), "")
	"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>bynk-lang status</title><style>\(style())</style></head><body><h1>bynk-lang status</h1><p>The org's live <a href=\"https://github.com/bynk-lang/bynk\">Bynk</a> services, checked every five minutes. Also: <a href=\"https://examples-index.bynk-lang.workers.dev/\">the examples index</a>, <a href=\"https://compat-board.bynk-lang.workers.dev/\">the compat board</a>. <a href=\"/status.json\">JSON</a></p><ul>\(cards)</ul></body></html>"
}

fn style() -> String {
	"body{font:15px/1.5 system-ui,sans-serif;margin:2rem auto;max-width:48rem;padding:0 1rem;color:#1f2328;background:#fff}ul{list-style:none;padding:0;display:grid;gap:1rem}.card{border:1px solid #d0d7de;border-radius:6px;padding:1rem}.card h2{margin:0;font-size:1.05rem}.card p{margin:.25rem 0;color:#59636e}.url{font-size:.85rem;overflow-wrap:anywhere}.state{font-size:.8rem;padding:.05rem .5rem;border-radius:1rem;margin-left:.4rem;vertical-align:middle}.up{background:#dafbe1;color:#116329}.down{background:#ffebe9;color:#a40e26}.none{background:#f6f8fa;color:#59636e}.strip{display:flex;gap:2px;margin-top:.5rem}.strip i{flex:1;height:1.25rem;border-radius:2px;max-width:.6rem}.strip .u{background:#2da44e}.strip .d{background:#cf222e}a{color:#0969da}@media (prefers-color-scheme:dark){body{color:#e6edf3;background:#0d1117}.card{border-color:#30363d}.card p{color:#9198a1}.up{background:#12361f;color:#7ee2a8}.down{background:#4b1113;color:#ffa198}.none{background:#161b22;color:#9198a1}a{color:#4493f8}}"
}
