suite status.model {
	case "uptime is a percentage scaled by ten, or -1 with no checks" {
		let checks = [
			Check { at: 1000, up: true, status: 200, ms: 50 },
			Check { at: 2000, up: true, status: 200, ms: 50 },
			Check { at: 3000, up: false, status: 500, ms: 50 },
			Check { at: 4000, up: true, status: 200, ms: 50 },
		]
		expect uptime(checks, 0) == 750
		expect uptime(checks, 3500) == 1000
		expect uptime(checks, 5000) == -1
		expect uptime([], 0) == -1
	}

	case "a summary takes the newest check, whatever the order" {
		let t = Target { name: "board", url: "https://example.test/" }
		let checks = [
			Check { at: 3000, up: true, status: 200, ms: 40 },
			Check { at: 1000, up: false, status: 0, ms: 9000 },
			Check { at: 2000, up: true, status: 200, ms: 60 },
		]
		let s = summarise(t, checks, 3000)
		expect s.checked
		expect s.up
		expect s.ms == 40
		expect s.last_at == 3000
		expect s.last_failure_at == 1000
		expect s.recent == [false, true, true]
	}

	case "a target with no checks is not checked yet" {
		let s = summarise(Target { name: "board", url: "https://example.test/" }, [], 0)
		expect s.checked == false
		expect s.uptime_24h == -1
		expect s.last_failure_at == 0
		expect s.recent.count() == 0
	}

	case "the strip shows at most the 48 most recent checks" {
		let one = [Check { at: 1, up: true, status: 200, ms: 1 }]
		let many = one
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
		expect many.count() == 64
		expect summarise(Target { name: "board", url: "https://example.test/" }, many, 1).recent.count() == 48
	}

	// An agent's whole state is one stored value, so a week of checks per
	// target has to fit in one. 2,048 checks with realistic timestamps.
	case "a week of one target's checks encodes well under a stored value's limit" {
		let one = [Check { at: 1791609286810, up: true, status: 200, ms: 123 }]
		let week = one
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
			.flatMap((c) => [c, c])
		expect week.count() == 2048
		expect Json.encode(week).length() < 200000
	}
}
