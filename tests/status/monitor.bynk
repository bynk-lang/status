suite status.monitor {
	case "a cron run checks every target once and records each result" {
		stub Probe.check(_) returns Check { at: 1000, up: true, status: 200, ms: 50 }
		let r <- checks.schedule("*/5 * * * *")
		expect r is Ok(_)
		expect Probe.check called 3 times
		let board <- Monitor("compat-board").history(0)
		let index <- Monitor("examples-index").history(0)
		let registry <- Monitor("registry").history(0)
		expect board.count() == 1
		expect index.count() == 1
		expect registry.count() == 1
	}

	case "a target being down is recorded, and the run still succeeds" {
		stub Probe.check(_) returns Check { at: 1000, up: false, status: 0, ms: 9000 }
		let r <- checks.schedule("*/5 * * * *")
		expect r is Ok(_)
		let board <- Monitor("compat-board").history(0)
		expect board.filter((c) => c.up == false).count() == 1
	}

	case "checks older than seven days are dropped" {
		stub Clock.now() returns each [Instant.fromEpochMillis(0), Instant.fromEpochMillis(8 * 86400000)]
		let _ <- Monitor("compat-board").add(Check { at: 0, up: false, status: 500, ms: 10 })
		let _ <- Monitor("compat-board").add(Check {
			at: 8 * 86400000,
			up: true,
			status: 200,
			ms: 10,
		})
		let kept <- Monitor("compat-board").history(0)
		expect kept.count() == 1
		expect kept.filter((c) => c.up).count() == 1
	}

	case "the status is public, as JSON and as a page" {
		let j <- api.GET("/status.json") by Visitor
		expect j is Ok(_)
		let p <- api.GET("/") by Visitor
		expect p is Raw(_, _)
	}
}
